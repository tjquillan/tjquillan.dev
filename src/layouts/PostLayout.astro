---
import { CONFIG } from "@/config";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  title: string;
  description?: string;
  author?: string;
  ogImage?: string;
  pubDate: Date;
  updatedDate?: Date;
};

const {
  title,
  description,
  author = CONFIG.author,
  ogImage = "/og/default.png",
  pubDate,
  updatedDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, CONFIG.website).href;
const ogImageURL = new URL(ogImage, CONFIG.website).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: ogImageURL,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: {
    "@type": "Person",
    name: author,
  },
  mainEntityOfPage: canonicalURL,
};
---

<BaseLayout {title} {description} {author} {ogImage} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</BaseLayout>
