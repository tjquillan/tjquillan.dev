---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";

import { render } from "astro:content";

import PostLayout from "@/layouts/PostLayout.astro";
import { getPublishedPosts } from "@/lib/blog";
import { getNormalizedPathname } from "@/lib/url";

type Props = {
  post: CollectionEntry<"blog">;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;

const { title, description, author, pubDate, updatedDate } = post.data;
const ogImage = `/og/posts/${post.id}.png`;

const { Content } = await render(post);
---

<PostLayout
  title={title}
  description={description}
  author={author}
  ogImage={ogImage}
  pubDate={pubDate}
  updatedDate={updatedDate}
>
  <main id="main-content" class="app-layout mt-8 pb-12" data-pagefind-body>
    <h1
      transition:name={getNormalizedPathname(Astro.url)}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <article id="article" class="app-prose mt-8 w-full max-w-app">
      <Content />
    </article>
  </main>
</PostLayout>
