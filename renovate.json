{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":pinDependencies", ":automergePatch"],
  "packageRules": [
    {
      // Group expressive-code updates
      "matchPackageNames": ["/expressive-code/"],
      "groupName": "expressive-code"
    },
    {
      // Group Tabler Icons updates
      "matchPackageNames": ["/^@tabler\\/icons/"],
      "groupName": "tabler-icons"
    }
  ]
}
